# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE EJEMPLO - Report-IT Backend
# ═══════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y ajusta los valores según tu entorno
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# SEED DEMO - Generador de Datos de Demostración
# ───────────────────────────────────────────────────────────────────────────
# Activa la generación automática de datos de demostración al iniciar el servidor

# Activar generación de datos demo (true/false)
SEED_DEMO=false

# Cantidad de reportes a generar (recomendado: 5000-10000)
SEED_REPORTS=5000

# Limpiar reportes existentes antes de generar (true/false)
SEED_CLEAR=false

# ───────────────────────────────────────────────────────────────────────────
# EJEMPLOS DE USO
# ───────────────────────────────────────────────────────────────────────────

# Prueba rápida (1,000 reportes, ~10 segundos)
# SEED_DEMO=true
# SEED_REPORTS=1000

# Demo estándar (5,000 reportes, ~30 segundos)
# SEED_DEMO=true
# SEED_REPORTS=5000

# Demo completa (10,000 reportes, ~1 minuto)
# SEED_DEMO=true
# SEED_REPORTS=10000

# Performance test (100,000 reportes, ~10 minutos)
# SEED_DEMO=true
# SEED_REPORTS=100000

# Regenerar datos desde cero
# SEED_DEMO=true
# SEED_CLEAR=true
# SEED_REPORTS=5000

# ───────────────────────────────────────────────────────────────────────────
# BASES DE DATOS
# ───────────────────────────────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb://localhost:27017/reportit_db

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=app_db

# ───────────────────────────────────────────────────────────────────────────
# SERVIDOR
# ───────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════
# DOCUMENTACIÓN
# ═══════════════════════════════════════════════════════════════════════════
# Para más información sobre el generador de datos demo:
# - Ver: backend/SEED_README.md (guía rápida)
# - Ver: SEED_DEMO_GUIDE.md (documentación completa)
# ═══════════════════════════════════════════════════════════════════════════